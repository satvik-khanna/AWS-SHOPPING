# Copy to .env and fill in what you have. Everything is optional: with nothing
# set, KAI runs on clearly labeled fixtures and local fallbacks.

# --- X (official API, recent search) ---------------------------------------
X_BEARER_TOKEN=
# Hard ceiling on estimated X API spend tracked by KAI (USD, cumulative).
X_API_MAX_SPEND_USD=1.00
X_COST_PER_POST_USD=0.005
X_COST_PER_USER_USD=0.010
X_MAX_RESULTS_PER_QUERY=10
X_MAX_QUERIES_PER_REFRESH=4
X_CACHE_TTL_S=900

# --- Indexed web search of public X posts (Brave Search API) ----------------
BRAVE_SEARCH_API_KEY=

# --- LLM for translation / extraction (OpenAI-compatible or Anthropic) ------
# OPENAI_BASE_URL can point at any OpenAI-compatible endpoint, including the
# SIE gateway (https://api.superlinked.com/v1).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=

# --- Superlinked SIE (ranking: encode + score) ------------------------------
# Serverless: set SIE_API_KEY (base URL defaults to https://api.superlinked.com).
# Self-hosted: set SIE_BASE_URL=http://localhost:8080
SIE_API_KEY=
SIE_BASE_URL=
SIE_EMBED_MODEL=BAAI/bge-m3
SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# --- Senso (cited cost sources) ----------------------------------------------
SENSO_API_KEY=
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1

# --- Cognee (graph memory). Needs `uv sync --extra cognee` and LLM_API_KEY ---
COGNEE_ENABLED=auto
LLM_API_KEY=

# --- Rakuten Ichiba (marketplace search) -------------------------------------
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_REFERER=

# --- Behaviour ----------------------------------------------------------------
KAI_ALLOW_FIXTURES=true
KAI_DATA_DIR=var
KAI_FETCH_MAX_PER_RUN=12
KAI_RESPECT_ROBOTS=true
FX_FALLBACK_USD_PER_JPY=0.0070
CA_USE_TAX_RATE=0.1025
